APP_ENV=development
APP_ORIGIN=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./studio.db
# Production: postgresql+psycopg://studio:password@database/studio
JWT_SECRET=
ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
BILLING_ENABLED=false
# Keep false during test-mode acceptance. Live activation requires final merchant/pricing approval.
ALLOW_LIVE_BILLING=false
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
TRIAL_DAYS=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Free-host option: resend uses HTTPS, so SMTP ports and a paid worker are unnecessary.
MAIL_TRANSPORT=smtp
RESEND_API_KEY=
FREE_BETA=false
# Opt-in request-triggered retries; not an always-on delivery guarantee.
INLINE_MAIL=false
# Sign-in step-up link validity: 600–1800 seconds; measured from request time.
LOGIN_CONFIRMATION_TTL_SECONDS=1200

# Optional integrations. Disabled until explicitly configured.
AI_ENABLED=false
AI_PROVIDER=openai
# Local development only; fixed loopback Ollama endpoint, no automatic downloads.
OLLAMA_MODEL=phi4-mini:3.8b
OPENAI_API_KEY=
OPENAI_MODEL=
SHARING_ENABLED=false
